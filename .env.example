PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/tinglov.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Backend Security Keys (Required)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
CAPTCHA_SECRET=your_super_secret_captcha_hmac_key_here

# Optional: Distributed Redis for production rate limiting & horizontal scaling
# REDIS_URL=redis://default:password@host:6379

# Admin Panel Configuration (Render.com Environment Variables)
# ADMIN_PATH: Admin panel URL manzili (masalan: /admin, /boshqaruv, /maxfiy-panel-77)
ADMIN_PATH=/admin
VITE_ADMIN_PATH=/admin

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here
# Optional: bcrypt/argon2 hash of the admin password (leave empty if unused)
ADMIN_PASSWORD_HASH=

# Cloudflare R2 Video Streaming Storage (Zero Egress)
# Set your public R2 bucket domain or custom domain (e.g. https://pub-xxxx.r2.dev or https://media.tinglov.me)
CLOUDFLARE_R2_URL=https://pub-your_r2_bucket_subdomain.r2.dev
VITE_CLOUDFLARE_R2_URL=https://pub-your_r2_bucket_subdomain.r2.dev

# Keep-Alive & Anti-Sleep for Render.com Free Tier
# Set your public service URL so the server can ping itself every 12 minutes (and for UptimeRobot)
RENDER_EXTERNAL_URL=https://tinglov.onrender.com
